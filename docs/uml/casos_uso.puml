@startuml
left to right direction
actor Administrador as Admin
actor Técnico as Tech
actor Solicitante as User
rectangle SysTrack {
 usecase "Autenticarse" as UC1
 usecase "Gestionar activos" as UC2
 usecase "Consultar inventario" as UC3
 usecase "Registrar incidente" as UC4
 usecase "Atender incidente" as UC5
 usecase "Programar mantenimiento" as UC6
 usecase "Registrar intervención" as UC7
 usecase "Consultar indicadores" as UC8
}
Admin --> UC1
Tech --> UC1
User --> UC1
Admin --> UC2
Tech --> UC3
User --> UC3
User --> UC4
Tech --> UC5
Admin --> UC6
Tech --> UC7
Admin --> UC8
@enduml
